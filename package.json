{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener with Fastify, MongoDB, Redis and Hashids (base62)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file-if-exists=.env --watch src/index.ts",
    "format": "prettier --write src test vitest.config.ts",
    "format:check": "prettier --check src test vitest.config.ts",
    "lint": "oxlint",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.5.1"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.2",
    "@scalar/fastify-api-reference": "1.70.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "hashids": "2.3.0",
    "ioredis": "6.0.0",
    "mongodb": "7.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "ioredis-mock": "8.13.1",
    "mongodb-memory-server": "11.3.0",
    "oxlint": "1.85.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
